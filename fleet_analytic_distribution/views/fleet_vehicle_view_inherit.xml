<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_form_inherit_analytic" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.analytic</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <!-- Insertamos el nuevo campo después del campo 'model_id' -->
            <xpath expr="//field[@name='model_id']" position="after">
                <field name="analytic_distribution_id"/>
            </xpath>
        </field>
    </record>
</odoo>
