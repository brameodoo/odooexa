<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Heredamos la vista de formulario de flota -->
        <record id="view_fleet_vehicle_form_inherit_analytic" model="ir.ui.view">
            <field name="name">fleet.vehicle.form.inherit.analytic</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
            <field name="arch" type="xml">

                <!-- Insertamos el campo dentro del grupo de información técnica -->
                <xpath expr="//group[@name='odometer']" position="after">
                    <group string="Distribución Analítica">
                        <field name="analytic_distribution_id"/>
                    </group>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
