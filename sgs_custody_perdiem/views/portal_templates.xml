<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_custodian_home" name="Portal custodio SGS">
        <t t-call="portal.portal_layout">
            <t t-call="sgs_custody_perdiem.pwa_head_template"/>
            <div class="sgs-portal container py-4">
                <header class="mb-4 p-4 rounded" style="background:#1b1b1b;color:#fff;">
                    <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
                        <div>
                            <div class="text-warning text-uppercase">SGS · Control de Viáticos</div>
                            <h1 class="display-5"><t t-esc="custodian.name"/></h1>
                            <p class="mb-0"><t t-esc="custodian.employee_number or ''"/> <t t-if="custodian.position">· <t t-esc="custodian.position"/></t></p>
                        </div>
                        <div class="p-3 rounded border border-warning text-end">
                            <span class="text-muted">Saldo disponible</span><br/>
                            <strong class="h3 text-warning"><t t-esc="format_amount(custodian.balance, custodian.currency_id)"/></strong>
                        </div>
                    </div>
                </header>

                <t t-if="ok == 'servicio'">
                    <div class="alert alert-success">Servicio recibido correctamente. Queda pendiente de validación administrativa.</div>
                </t>
                <t t-if="ok == 'fiscal'">
                    <div class="alert alert-success">Comprobante recibido. La validación OCR/IA se registró en movimientos recientes.</div>
                </t>

                <section class="row g-3 mb-4">
                    <div class="col-md-3"><div class="card"><div class="card-body text-center"><small>Fondo inicial</small><br/><strong><t t-esc="format_amount(custodian.initial_fund, custodian.currency_id)"/></strong></div></div></div>
                    <div class="col-md-3"><div class="card"><div class="card-body text-center"><small>Depósitos</small><br/><strong><t t-esc="format_amount(custodian.total_deposits, custodian.currency_id)"/></strong></div></div></div>
                    <div class="col-md-3"><div class="card"><div class="card-body text-center"><small>Gastos</small><br/><strong><t t-esc="format_amount(custodian.total_expenses, custodian.currency_id)"/></strong></div></div></div>
                    <div class="col-md-3"><div class="card"><div class="card-body text-center"><small>Facturas</small><br/><strong><t t-esc="format_amount(custodian.total_fiscal, custodian.currency_id)"/></strong></div></div></div>
                </section>

                <section class="row g-4">
                    <article class="col-lg-6">
                        <div class="card h-100">
                            <div class="card-body">
                                <h2 class="h4 text-warning">Cerrar servicio</h2>
                                <p>Registra ruta, vehículo, compañero y desglose de gastos.</p>
                                <form t-att-action="'/sgs/custodio/%s/servicio' % token" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-3"><label class="form-label">Fecha del servicio</label><input class="form-control" type="date" name="date" required="required"/></div>
                                    <div class="mb-3"><label class="form-label">Cliente</label><select class="form-select" name="client_id"><option value="">— Seleccionar —</option><t t-foreach="clients" t-as="client"><option t-att-value="client.id"><t t-esc="client.name"/></option></t></select></div>
                                    <div class="row g-3"><div class="col-md-6"><label class="form-label">Origen</label><input class="form-control" name="origin"/></div><div class="col-md-6"><label class="form-label">Destino</label><input class="form-control" name="destination"/></div></div>
                                    <div class="mb-3 mt-3"><label class="form-label">Vehículo</label><select class="form-select" name="vehicle_id"><option value="">— Seleccionar —</option><t t-foreach="vehicles" t-as="vehicle"><option t-att-value="vehicle.id"><t t-esc="vehicle.display_name"/></option></t></select></div>
                                    <div class="mb-3"><label class="form-label">Compañero</label><select class="form-select" name="companion_id"><option value="">— Voy solo —</option><t t-foreach="employees" t-as="employee"><option t-att-value="employee.id"><t t-esc="employee.name"/></option></t></select></div>
                                    <div class="row g-3">
                                        <div class="col-md-6"><label class="form-label">Viáticos</label><input class="form-control" type="number" step="0.01" name="amount_perdiem" value="0"/></div>
                                        <div class="col-md-6"><label class="form-label">Gasolina</label><input class="form-control" type="number" step="0.01" name="amount_fuel" value="0"/></div>
                                        <div class="col-md-6"><label class="form-label">Hospedaje</label><input class="form-control" type="number" step="0.01" name="amount_lodging" value="0"/></div>
                                        <div class="col-md-6"><label class="form-label">Gastos varios</label><input class="form-control" type="number" step="0.01" name="amount_misc" value="0"/></div>
                                    </div>
                                    <div class="mb-3 mt-3"><label class="form-label">Detalle gastos varios</label><input class="form-control" name="misc_detail"/></div>
                                    <h3 class="h5">Casetas</h3>
                                    <t t-foreach="[1, 2, 3]" t-as="i">
                                        <div class="row g-2 mb-2"><div class="col-md-4"><input class="form-control" name="toll_name[]" placeholder="Caseta"/></div><div class="col-md-3"><input class="form-control" type="number" step="0.01" name="toll_amount[]" placeholder="Monto"/></div><div class="col-md-5"><input class="form-control" type="file" name="toll_image[]" accept="image/*" capture="camera"/></div></div>
                                    </t>
                                    <div class="mb-3"><label class="form-label">Evidencia general</label><input class="form-control" type="file" name="evidence" accept="image/*" capture="camera"/></div>
                                    <div class="mb-3"><label class="form-label">Comentarios</label><textarea class="form-control" name="comments"></textarea></div>
                                    <button type="submit" class="btn btn-primary w-100">Cerrar servicio</button>
                                </form>
                            </div>
                        </div>
                    </article>

                    <article class="col-lg-6">
                        <div class="card h-100">
                            <div class="card-body">
                                <h2 class="h4 text-warning">Comprobante fiscal / Gasto</h2>
                                <p>Sube una foto de factura o ticket. La acción OCR/IA se ejecutará sobre el comprobante.</p>
                                <form t-att-action="'/sgs/custodio/%s/fiscal' % token" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-3"><label class="form-label">Foto del comprobante</label><input class="form-control" type="file" name="image" accept="image/*" capture="camera" required="required"/></div>
                                    <button type="submit" class="btn btn-info w-100">Subir y Procesar con IA</button>
                                </form>
                                <h2 class="h4 text-warning mt-4">Movimientos recientes</h2>
                                <div class="list-group">
                                    <t t-foreach="fiscal_receipts" t-as="fr">
                                        <div class="list-group-item">
                                            <div class="d-flex justify-content-between"><strong><t t-esc="fr.description or 'Comprobante'"/></strong><strong><t t-esc="format_amount(fr.amount, fr.currency_id)"/></strong></div>
                                            <small><t t-esc="fr.date"/> · <t t-esc="fr.provider or fr.ocr_status"/></small>
                                        </div>
                                    </t>
                                    <t t-foreach="services" t-as="svc">
                                        <div class="list-group-item">
                                            <div class="d-flex justify-content-between"><strong>Servicio: <t t-esc="svc.name"/></strong><strong><t t-esc="format_amount(svc.amount_total, svc.currency_id)"/></strong></div>
                                            <small><t t-esc="svc.date"/> · <t t-esc="svc.origin or ''"/> → <t t-esc="svc.destination or ''"/> · <t t-esc="dict(svc._fields['status'].selection).get(svc.status)"/></small>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </article>
                </section>
            </div>
        </t>
    </template>
</odoo>
