<odoo>
    <data>
        <template id="portal_custodian_home" name="Portal custodio SGS">
            <xpath expr="." position="inside">
                <link rel="manifest" href="/sgs_custody_perdiem/static/src/manifest.json"/>
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="black"/>
            </xpath>
            
            <t t-call="portal.portal_layout">
                <div class="sgs-portal">
                    <header class="sgs-header">
                        <div>
                            <div class="sgs-overline">SGS · Control de Viáticos</div>
                            <h1><t t-esc="custodian.name"/></h1>
                            <p><t t-esc="custodian.employee_number or ''"/> <t t-if="custodian.position">· <t t-esc="custodian.position"/></t></p>
                        </div>
                        <div class="sgs-balance" t-att-class="custodian.balance &lt; 0 and 'sgs-balance negative' or 'sgs-balance'">
                            <span>Saldo disponible</span>
                            <strong><t t-esc="format_amount(custodian.balance, custodian.currency_id)"/></strong>
                        </div>
                    </header>

                    <section class="sgs-kpis">
                        <div class="sgs-kpi"><span>Fondo inicial</span><strong><t t-esc="format_amount(custodian.initial_fund, custodian.currency_id)"/></strong></div>
                        <div class="sgs-kpi"><span>Depósitos</span><strong><t t-esc="format_amount(custodian.total_deposits, custodian.currency_id)"/></strong></div>
                        <div class="sgs-kpi"><span>Gastos</span><strong><t t-esc="format_amount(custodian.total_expenses, custodian.currency_id)"/></strong></div>
                        <div class="sgs-kpi"><span>Facturas</span><strong><t t-esc="format_amount(custodian.total_fiscal, custodian.currency_id)"/></strong></div>
                    </section>

                    <section class="sgs-grid">
                        <article class="sgs-card">
                            <h2>Cerrar servicio</h2>
                            <p>Registra ruta, vehículo, compañero y desglose de gastos. Los importes quedarán pendientes de validación administrativa.</p>
                            <form t-att-action="'/sgs/custodio/%s/servicio' % token" method="post" enctype="multipart/form-data" class="sgs-form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                
                                <div class="sgs-two">
                                    <label>Inicio del servicio (Fecha y Hora)
                                        <input type="datetime-local" name="start_datetime" required="required"/>
                                    </label>
                                    <label>Término del servicio (Fecha y Hora)
                                        <input type="datetime-local" name="end_datetime" required="required"/>
                                    </label>
                                </div>
                                
                                <label>Cliente<select name="client_id"><option value="">— Seleccionar —</option><t t-foreach="clients" t-as="client"><option t-att-value="client.id"><t t-esc="client.name"/></option></t></select></label>
                                <div class="sgs-two"><label>Origen<input name="origin" placeholder="Ciudad / punto de salida"/></label><label>Destino<input name="destination" placeholder="Ciudad / punto de llegada"/></label></div> 
                                
                                <label>Vehículo
                                    <select name="vehicle_id">
                                        <option value="">— Abordo —</option>
                                        <t t-foreach="vehicles" t-as="vehicle">
                                            <option t-att-value="vehicle.id">
                                                <t t-if="vehicle.license_plate">[<t t-esc="vehicle.license_plate"/>]</t> 
                                                <t t-esc="vehicle.model_id.brand_id.name or ''"/> 
                                                <t t-esc="vehicle.model_id.name or ''"/>
                                            </option>
                                        </t>
                                    </select>
                                </label>
                                
                                <label>Compañero
                                    <select name="companion_employee_id">
                                        <option value="">— Voy solo —</option>
                                        <t t-foreach="employees" t-as="emp">
                                            <option t-att-value="emp.id"><t t-esc="emp.name"/></option>
                                        </t>
                                    </select>
                                </label>
                                
                                <div class="sgs-expenses-section" style="margin-top: 20px; border-top: 2px solid #e9ecef; padding-top: 15px;">
                                    <h3 style="font-size: 1.1em; margin-bottom: 5px; color: #333;">Desglose de Gastos y Comprobantes</h3>
                                    <p class="sgs-help" style="color: #a94442; font-size: 0.85em; margin-bottom: 15px; font-weight: bold;">
                                        * Nota: Si registras un monto en Gasolina o Hospedaje, es obligatorio capturar la fotografía del comprobante.
                                    </p>
                                    
                                    <div class="sgs-expense-row" style="background: #f8f9fa; padding: 12px; border-radius: 6px; margin-bottom: 12px; border-left: 4px solid #ffc107;">
                                        <div class="sgs-two">
                                            <label style="margin-bottom: 0;">Monto Gasolina
                                                <input type="number" step="0.01" name="amount_fuel" id="amount_fuel" value="0" style="width: 100%; margin-top: 5px;" onchange="validateGastoRequired('amount_fuel', 'fuel_ticket')"/>
                                            </label>
                                            <label id="label_fuel_ticket" style="margin-bottom: 0;">Foto del Ticket (Gasolina)
                                                <input type="file" name="fuel_ticket" id="fuel_ticket" accept="image/*" capture="camera" style="width: 100%; margin-top: 5px; font-size: 0.9em;"/>
                                            </label>
                                        </div>
                                    </div>

                                    <div class="sgs-expense-row" style="background: #f8f9fa; padding: 12px; border-radius: 6px; margin-bottom: 12px; border-left: 4px solid #17a2b8;">
                                        <div class="sgs-two">
                                            <label style="margin-bottom: 0;">Monto Hospedaje (Hotel)
                                                <input type="number" step="0.01" name="amount_lodging" id="amount_lodging" value="0" style="width: 100%; margin-top: 5px;" onchange="validateGastoRequired('amount_lodging', 'lodging_ticket')"/>
                                            </label>
                                            <label id="label_lodging_ticket" style="margin-bottom: 0;">Comprobante Hospedaje
                                                <input type="file" name="lodging_ticket" id="lodging_ticket" accept="image/*" capture="camera" style="width: 100%; margin-top: 5px; font-size: 0.9em;"/>
                                            </label>
                                        </div>
                                    </div>

                                    <div class="sgs-two" style="margin-bottom: 12px;">
                                        <label>Viáticos (Alimentos / Otros)
                                            <input type="number" step="0.01" name="amount_perdiem" value="0"/>
                                        </label>
                                        <label>Gastos varios
                                            <input type="number" step="0.01" name="amount_misc" value="0"/>
                                        </label>
                                    </div>
                                </div>

                                <label>Especificar gastos varios<input name="misc_detail" placeholder="Obligatorio si hay gastos varios"/></label>
                                
                                <div class="sgs-tolls">
                                    <h3>Casetas</h3>
                                    <p>Si tienes varias casetas, puedes llenar hasta tres líneas en esta versión inicial.</p>
                                    <t t-foreach="[1,2,3]" t-as="i">
                                        <div class="sgs-three">
                                            <input name="toll_name[]" placeholder="Caseta"/>
                                            <input type="number" step="0.01" name="toll_amount[]" placeholder="Monto"/>
                                            <input type="file" name="toll_image[]" accept="image/*" capture="camera"/>
                                        </div>
                                    </t>
                                </div>
                                
                                <label>Evidencia general<input type="file" name="evidence" accept="image/*" capture="camera"/></label>
                                <label>Comentarios<textarea name="comments" placeholder="Observaciones o aclaraciones"></textarea></label>
                                <button type="submit" class="sgs-btn primary">Cerrar servicio</button>

                                <script type="text/javascript">
                                    function validateGastoRequired(amountId, fileId) {
                                        var amountInput = document.getElementById(amountId);
                                        var fileInput = document.getElementById(fileId);
                                        var labelInput = document.getElementById('label_' + fileId);
                                        
                                        if (amountInput &amp;&amp; fileInput &amp;&amp; labelInput) {
                                            if (parseFloat(amountInput.value) &gt; 0) {
                                                fileInput.setAttribute('required', 'required');
                                                labelInput.style.color = '#a94442';
                                                labelInput.style.fontWeight = 'bold';
                                            } else {
                                                fileInput.removeAttribute('required');
                                                labelInput.style.color = '';
                                                labelInput.style.fontWeight = 'normal';
                                            }
                                        }
                                    }
                                </script>
                            </form>
                        </article>

                        <article class="sgs-card">
                            <h2>Comprobante fiscal / Gasto</h2>
                            <p>Sube una foto de tu factura o ticket. Nuestra IA extraerá los datos automáticamente y clasificará si es fiscal o no deducible.</p>
                            <form t-att-action="'/sgs/custodio/%s/fiscal' % token" method="post" enctype="multipart/form-data" class="sgs-form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <label>Foto del comprobante (Factura o Ticket)<input type="file" name="image" accept="image/*" capture="camera" required="required"/></label>
                                <p class="sgs-help">No necesitas llenar los datos, la IA lo hará por ti.</p>
                                <button type="submit" class="sgs-btn blue">Subir y Procesar con IA</button>
                            </form>

                            <h2 class="sgs-mt">Movimientos recientes</h2>
                            <div class="sgs-movements">
                                <t t-if="request.params.get('ok') == 'fiscal'">
                                    <div class="alert alert-success" style="background: #d4edda; color: #155724; padding: 10px; border-radius: 4px; margin-bottom: 15px; font-size: 0.9em;">
                                        ¡Comprobante recibido! La IA lo está procesando. Refresca en unos segundos.
                                    </div>
                                </t>
                                
                                <t t-foreach="fiscal_receipts" t-as="fr">
                                    <div class="sgs-move">
                                        <div>
                                            <strong><t t-esc="fr.description or 'Comprobante'"/></strong><br/>
                                            <span><t t-esc="fr.date"/> · <t t-esc="fr.provider or 'Procesando...'"/></span>
                                        </div>
                                        <div>
                                            <strong><t t-esc="format_amount(fr.amount, fr.currency_id)"/></strong><br/>
                                            <t t-if="fr.ocr_status == 'pending' or fr.ocr_status == 'processing'">
                                                <span class="st pending" style="background: #fff3cd; color: #856404;">Leyendo IA...</span>
                                            </t>
                                            <t t-elif="fr.ocr_status == 'failed'">
                                                <span class="st rejected" style="background: #f8d7da; color: #721c24; display: block; margin-bottom: 2px;">Error IA</span>
                                                <span style="font-size: 0.7em; color: #721c24; display: block; line-height: 1.1;" t-esc="fr.ocr_error_message"/>
                                            </t>
                                            <t t-else="">
                                                <span t-att-class="'st ' + (fr.is_fiscal and 'approved' or 'pending')">
                                                    <t t-if="fr.is_fiscal">Fiscal</t>
                                                    <t t-else="">No Deducible</t>
                                                </span>
                                            </t>
                                        </div>
                                    </div>
                                </t>

                                <t t-foreach="services" t-as="svc">
                                    <div class="sgs-move">
                                        <div>
                                            <strong>Servicio: <t t-esc="svc.name"/></strong><br/>
                                            <span><t t-esc="svc.date"/> · <t t-esc="svc.origin or ''"/> → <t t-esc="svc.destination or ''"/></span>
                                        </div>
                                        <div>
                                            <strong><t t-esc="format_amount(svc.amount_total, svc.currency_id)"/></strong><br/>
                                            <span t-att-class="'st ' + svc.status"><t t-esc="dict(svc._fields['status'].selection).get(svc.status)"/></span>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </article>
                    </section>
                </div>
            </t>
        </template>
    </data>
</odoo>
